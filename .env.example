# Copy this file to .env and fill in your online MySQL details.
# Aiven example host: mysql-xxxx-yourname.aivencloud.com, port is shown on the service page
DB_URL=jdbc:mysql://<host>:<port>/<database>?sslMode=REQUIRED
DB_USERNAME=<username>
DB_PASSWORD=<password>

# Base of the short links that get returned (served through the Cloudflare Tunnel)
SHORT_LINK_BASEURL=https://go.pumudu.indevs.in
SHORT_LINK_TENANT_ID=pumudu.indevs.in

# Required for production; comma-separated hostnames only.
# SHORT_LINK_ALLOWED_HOSTS=workroo.click,progress.workroo.click

# Shared secret for /api/** (sent as the X-API-Key header). Required (32+ chars) when SPRING_PROFILES_ACTIVE=prod.
# Generate one with: openssl rand -hex 32
# SHORT_LINK_API_KEY=
